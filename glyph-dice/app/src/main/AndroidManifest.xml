<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to drive the Glyph Matrix. -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_dice_toy"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_dice_toy"
        android:supportsRtl="true"
        android:theme="@style/Theme.GlyphDice">

        <!-- Companion screen: just an "Add toy" button. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The Glyph Toy itself. The system discovers it via this action. -->
        <service
            android:name=".DiceGlyphToyService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>

            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/toy_name" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/ic_dice_toy" />
            <!-- 1 = this toy reacts to a long press (we use it to roll). -->
            <meta-data
                android:name="com.nothing.glyph.toy.longpress"
                android:value="1" />
            <!-- 1 = this toy can show on the Always-On Display. -->
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1" />
        </service>
    </application>

</manifest>
